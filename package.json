{
  "name": "opengames",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source app for two-player games. Player to player.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/main.js",
    "demo": "node tools/demo.js",
    "test": "node --test --test-timeout=10000 test/*.test.js",
    "test:app": "node test/app.e2e.js && node test/games.e2e.js",
    "check": "node kit/check.js games/shikaku && node kit/check.js games/gemhold && node kit/check.js games/avioane"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "electron": "45.4.1", "playwright-core": "^1.50.0" },
  "pnpm": { "onlyBuiltDependencies": ["electron"] }
}
