{
  "name": "opengames",
  "version": "1.4.0",
  "private": true,
  "description": "Open-source app for two-player games. Player to player.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/main.js",
    "demo": "node tools/demo.js",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "test:app": "node test/app.e2e.js && node test/games.e2e.js && node test/solo.e2e.js && node test/starter.e2e.js && node test/web.e2e.js",
    "check": "node tools/check-all.js",
    "kit": "node tools/build-kit.js",
    "pack-app": "node tools/pack.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.50.0",
    "three": "^0.187.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "author": "DansLab"
}
